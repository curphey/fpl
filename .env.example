# AI Features (optional - can also be set in web app Settings)
ANTHROPIC_API_KEY

# Email Notifications (optional - get from resend.com)
RESEND_API_KEY=
FROM_EMAIL=FPL Insights <noreply@your-domain.com>

# Notifications API (for scheduled functions - generate a secure random string)
NOTIFICATIONS_API_KEY=

# Database (defaults to ./data/fpl.db if not specified)
DATABASE_PATH=./data/fpl.db

# Application URL (used for notification email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
